{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perchmarkets.com/schemas/postmarket_rank_calibration_artifact_v1.schema.json",
  "title": "Postmarket rank calibration artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "calibration_run_id",
    "experiment_id",
    "split",
    "evaluated_at_utc",
    "code_version",
    "input_digest_sha256",
    "report_sha256",
    "model_sha256",
    "model",
    "fitted_at_utc",
    "fitting_code_version",
    "development_definitive_labels",
    "development_positive_labels",
    "development_negative_labels",
    "training_brier_score",
    "training_expected_calibration_error",
    "report"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "postmarket_rank_calibration"},
    "calibration_run_id": {"type": "integer", "minimum": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["development", "holdout"]},
    "evaluated_at_utc": {"type": "string", "format": "date-time"},
    "code_version": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "input_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model": {"type": "object"},
    "fitted_at_utc": {"type": "string", "format": "date-time"},
    "fitting_code_version": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "development_definitive_labels": {"type": "integer", "minimum": 1},
    "development_positive_labels": {"type": "integer", "minimum": 1},
    "development_negative_labels": {"type": "integer", "minimum": 1},
    "training_brier_score": {"type": "number", "minimum": 0, "maximum": 1},
    "training_expected_calibration_error": {"type": "number", "minimum": 0, "maximum": 1},
    "report": {
      "type": "object",
      "required": [
        "split",
        "holdout_unblinded",
        "calibrated_quality_claim_valid",
        "brier_score",
        "expected_calibration_error",
        "blocking_reasons"
      ]
    }
  }
}
