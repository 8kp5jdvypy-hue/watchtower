{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perchmarkets.com/schemas/postmarket_evidence_campaign_v1.schema.json",
  "title": "Prospective postmarket evidence campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "campaign_id",
    "locked_at_utc",
    "coverage_start",
    "coverage_end",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "locked"},
    "campaign_id": {"type": "string", "minLength": 1},
    "locked_at_utc": {"type": "string", "format": "date-time"},
    "coverage_start": {"type": "string", "format": "date"},
    "coverage_end": {"type": "string", "format": "date"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_clean_sessions",
        "min_definitive_labels",
        "min_positive_labels",
        "min_recall",
        "min_precision",
        "max_detection_latency_seconds",
        "allowed_data_feeds",
        "allowed_market_data_providers",
        "allowed_audit_versions",
        "allowed_observer_versions",
        "allowed_audit_code_versions",
        "allowed_observer_code_versions",
        "require_zero_dirty_sessions",
        "require_zero_direction_mismatches",
        "require_complete_session_inventory"
      ],
      "properties": {
        "min_clean_sessions": {"type": "integer", "minimum": 10},
        "min_definitive_labels": {"type": "integer", "minimum": 1},
        "min_positive_labels": {"type": "integer", "minimum": 1},
        "min_recall": {"type": "number", "minimum": 0.95, "maximum": 1},
        "min_precision": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_detection_latency_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 330},
        "allowed_data_feeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_market_data_providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_audit_versions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "allowed_observer_versions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "allowed_audit_code_versions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_observer_code_versions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "require_zero_dirty_sessions": {"const": true},
        "require_zero_direction_mismatches": {"const": true},
        "require_complete_session_inventory": {"const": true}
      }
    }
  }
}
