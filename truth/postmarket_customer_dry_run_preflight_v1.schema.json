{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perchmarkets.com/schemas/postmarket_customer_dry_run_preflight_v1.schema.json",
  "title": "Postmarket customer dry-run campaign preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preflight_version", "checked_at_utc", "expected_revision",
    "actual_revision", "campaign_id", "campaign_sha256",
    "safe_to_begin_customer_dry_run_campaign", "customer_delivery_enabled",
    "checks"
  ],
  "properties": {
    "preflight_version": {"const": 1},
    "checked_at_utc": {"type": "string", "format": "date-time"},
    "expected_revision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "actual_revision": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "campaign_id": {"type": ["string", "null"]},
    "campaign_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "safe_to_begin_customer_dry_run_campaign": {"type": "boolean"},
    "customer_delivery_enabled": {"const": false},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "passed", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
