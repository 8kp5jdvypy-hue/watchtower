{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perchmarkets.com/schemas/postmarket_customer_delivery_policy_v2.schema.json",
  "title": "Postmarket customer-delivery readiness policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delivery_policy_version",
    "router_revision",
    "evidence_set_sha256",
    "evidence_gate_sha256",
    "rank_version",
    "minimum_evidence_score",
    "calibration_version",
    "calibration_model_sha256",
    "minimum_calibrated_quality",
    "maximum_ordinal_rank",
    "minimum_evidence_coverage_pct",
    "maximum_data_age_seconds",
    "allowed_states",
    "allowed_evidence_revisions",
    "allowed_calibration_revisions",
    "allowed_providers",
    "allowed_feeds"
  ],
  "properties": {
    "delivery_policy_version": {"const": 2},
    "router_revision": {"$ref": "#/$defs/revision"},
    "evidence_set_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_gate_sha256": {"$ref": "#/$defs/sha256"},
    "rank_version": {"type": "integer", "minimum": 1},
    "minimum_evidence_score": {"type": "number", "minimum": 0, "maximum": 100},
    "calibration_version": {"type": "integer", "minimum": 1},
    "calibration_model_sha256": {"$ref": "#/$defs/sha256"},
    "minimum_calibrated_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "maximum_ordinal_rank": {"type": "integer", "minimum": 1},
    "minimum_evidence_coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "maximum_data_age_seconds": {"type": "number", "exclusiveMinimum": 0},
    "allowed_states": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["CONFIRMED", "STRENGTHENING", "REQUALIFIED"]}
    },
    "allowed_evidence_revisions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/revision"}
    },
    "allowed_calibration_revisions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/revision"}
    },
    "allowed_providers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_feeds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
  }
}
