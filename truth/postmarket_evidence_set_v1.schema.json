{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perchmarkets.com/schemas/postmarket_evidence_set_v1.schema.json",
  "title": "Postmarket aggregate evidence set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "evidence_set_version",
    "created_at_utc",
    "coverage_start",
    "coverage_end",
    "policy",
    "session_reports",
    "control_artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "locked"},
    "evidence_set_version": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "coverage_start": {"type": "string", "format": "date"},
    "coverage_end": {"type": "string", "format": "date"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_clean_sessions",
        "min_definitive_labels",
        "min_positive_labels",
        "min_recall",
        "min_precision",
        "max_detection_latency_seconds",
        "allowed_data_feeds",
        "allowed_market_data_providers",
        "require_zero_dirty_sessions",
        "require_zero_direction_mismatches",
        "require_complete_session_inventory"
      ],
      "properties": {
        "min_clean_sessions": {"type": "integer", "minimum": 10},
        "min_definitive_labels": {"type": "integer", "minimum": 1},
        "min_positive_labels": {"type": "integer", "minimum": 1},
        "min_recall": {"type": "number", "minimum": 0.95, "maximum": 1},
        "min_precision": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_detection_latency_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 330
        },
        "allowed_data_feeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_market_data_providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "require_zero_dirty_sessions": {"const": true},
        "require_zero_direction_mismatches": {"const": true},
        "require_complete_session_inventory": {"const": true}
      }
    },
    "session_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session", "path", "sha256"],
        "properties": {
          "session": {"type": "string", "format": "date"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    },
    "control_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "revision", "completed_at_utc"],
        "properties": {
          "kind": {
            "enum": ["failure_injection", "kill_switch", "rollback_runbook"]
          },
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "revision": {"type": "string", "minLength": 1},
          "completed_at_utc": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
