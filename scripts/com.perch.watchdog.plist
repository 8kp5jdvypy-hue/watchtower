<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.perch.watchdog</string>

    <!-- Checks every 5 minutes whether bot/worker/runner (runner only
         during market hours) are down, and re-runs start.sh (idempotent)
         if so. See scripts/watchdog.sh. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/meowmeow/projects/watchtower/scripts/watchdog.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/meowmeow/projects/watchtower</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Every 5 minutes, at all times -- the script itself decides
         whether market hours make a runner-restart appropriate. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Fire once immediately on load too, so a fresh install doesn't
         wait a full 5 minutes for its first check. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/meowmeow/projects/watchtower/data/watchdog_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/meowmeow/projects/watchtower/data/watchdog_launchd.log</string>
</dict>
</plist>
