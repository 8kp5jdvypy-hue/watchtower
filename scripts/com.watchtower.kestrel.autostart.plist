<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.watchtower.kestrel.autostart</string>

    <!-- Run the idempotent wrapper; it starts only what isn't already up. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/meowmeow/projects/watchtower/scripts/start.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/meowmeow/projects/watchtower</string>

    <!-- launchd hands processes a bare environment; give start.sh (and the
         python3/caffeinate/pmset it calls) a usable PATH. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 7:20 AM America/Denver, Mon-Fri = 9:20 AM ET, 10 min before the
         market open. launchd uses local wall-clock time; ET and MT observe
         DST together, so this stays 9:20 ET year-round. Weekday 1-5 = Mon-Fri. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
    </array>

    <!-- Don't fire just because it was (re)loaded; only on the schedule. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/meowmeow/projects/watchtower/data/launchd_autostart.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/meowmeow/projects/watchtower/data/launchd_autostart.log</string>
</dict>
</plist>
