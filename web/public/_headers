# Cloudflare Workers static-assets reads this the same way Pages does.
# /assets/* filenames are content-hashed by Vite (index-<hash>.js) --
# the URL itself changes whenever the content does, so "cache forever"
# is correct, not stale: a new deploy is a new URL, never the same URL
# with different bytes. Without this, the default `must-revalidate`
# response makes every repeat visit pay a full round-trip to confirm
# what's already sitting in the browser's cache unchanged.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The brand share image, the favicon set, and fonts are stable,
# un-hashed filenames -- still safe to cache long, just not "immutable"
# (a future redeploy could legitimately replace og-landing.png, or a new
# designer mark could replace the icons, at the same URL). Google
# requires the favicon URL to be STABLE, which is exactly what these
# un-hashed paths give it -- see web/scripts/gen_favicons.py.
/brand/*
  Cache-Control: public, max-age=86400

# Root-level icon probes: /favicon.ico is what browsers and Googlebot
# request when no <link> resolves, and the manifest is referenced by
# index.html. Same stable-URL reasoning as /brand/* above.
/favicon.ico
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
