# Copy to .env.local for local dev (Vite loads .env.local automatically,
# and it's gitignored by Vite's default pattern — see .gitignore's *.local).
# Points at the internal API (see tradebot/api/app.py). In production
# this is baked in at build time via the Cloudflare Pages/Workers
# project's build environment variables, not committed here.
VITE_API_URL=http://localhost:8000
