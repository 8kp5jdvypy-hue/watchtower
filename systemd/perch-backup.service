# Runs scripts/backup.sh once — paired with perch-backup.timer for a
# nightly cadence. Runs on the host, not inside a container: the
# data/ directory is a bind mount, so the host's sqlite3 CLI sees the
# exact same files the containers are writing.
[Unit]
Description=Perch nightly database backup
After=perch.service

[Service]
Type=oneshot
WorkingDirectory=/opt/perch
# No User= line means this runs as root -- make that explicit via HOME
# rather than leaving it unset. Systemd does not set $HOME for a system
# unit unless User= or this is set; unset $HOME crashed backup.sh's
# off-box step under set -u (rclone/gpg config path resolution).
Environment=HOME=/root
# Optional (leading '-') -- backup.sh runs local-only backups fine
# without this file; it only supplies RCLONE_REMOTE and
# BACKUP_ENCRYPTION_PASSPHRASE_FILE for off-box shipping once that's
# configured. Deliberately separate from the main .env (application
# secrets) -- see docs/DEPLOYMENT.md's Backups section.
EnvironmentFile=-/opt/perch/.backup-env
ExecStart=/opt/perch/scripts/backup.sh
